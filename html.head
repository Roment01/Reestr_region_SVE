<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Реестр АТД Республики Светлославия</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --primary-navy: #1f4e78;
            --primary-navy-dark: #153754;
            --header-bg-num: #e2e8f0;
            --border-color: #cbd5e1;
            --hover-bg: #f8fafc;
            --accent-green: #16a34a;
            --accent-red: #dc2626;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f1f5f9;
            color: #1e293b;
            padding: 24px;
            min-height: 100vh;
        }

        .header-container {
            background-color: #ffffff;
            border-radius: 12px;
            padding: 24px 32px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            margin-bottom: 24px;
            border-left: 6px solid var(--primary-navy);
        }

        .header-title {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary-navy);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .header-subtitle {
            font-size: 14px;
            color: #64748b;
        }

        .toolbar {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
            flex-wrap: wrap;
            align-items: center;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            transition: all 0.2s ease;
            font-family: inherit;
        }

        .btn-primary {
            background-color: var(--primary-navy);
            color: #ffffff;
        }
        .btn-primary:hover {
            background-color: var(--primary-navy-dark);
        }

        .btn-success {
            background-color: var(--accent-green);
            color: #ffffff;
        }
        .btn-success:hover {
            background-color: #15803d;
        }

        .btn-secondary {
            background-color: #ffffff;
            color: #334155;
            border: 1px solid var(--border-color);
        }
        .btn-secondary:hover {
            background-color: #f8fafc;
            border-color: #94a3b8;
        }

        .btn-danger {
            background-color: #ffffff;
            color: var(--accent-red);
            border: 1px solid #fca5a5;
        }
        .btn-danger:hover {
            background-color: #fef2f2;
        }

        .status-msg {
            font-size: 13px;
            color: var(--accent-green);
            font-weight: 600;
            opacity: 0;
            transition: opacity 0.3s ease;
            margin-left: auto;
        }
        .status-msg.visible {
            opacity: 1;
        }

        .table-wrapper {
            background-color: #ffffff;
            border-radius: 12px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
            overflow-x: auto;
            border: 1px solid var(--border-color);
            max-height: 70vh;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            text-align: left;
            min-width: 1400px;
        }

        thead {
            position: sticky;
            top: 0;
            z-index: 10;
        }

        /* First Header Row: Numbers */
        tr.header-row-numbers th {
            background-color: var(--header-bg-num);
            color: #475569;
            font-weight: 700;
            text-align: center;
            border: 1px solid var(--border-color);
            padding: 8px 12px;
            font-size: 12px;
        }

        /* Second Header Row: Column Titles */
        tr.header-row-titles th {
            background-color: var(--primary-navy);
            color: #ffffff;
            font-weight: 600;
            text-align: center;
            border: 1px solid #1e3a8a;
            padding: 12px;
            vertical-align: middle;
            line-height: 1.3;
        }

        tbody td {
            border: 1px solid var(--border-color);
            padding: 8px 10px;
            vertical-align: top;
            background-color: #ffffff;
            outline: none;
            transition: background-color 0.15s ease;
        }

        tbody td:focus {
            background-color: #eff6ff;
            box-shadow: inset 0 0 0 2px #3b82f6;
        }

        tbody tr:hover td {
            background-color: #f8fafc;
        }

        td.col-num {
            text-align: center;
            font-weight: 600;
            color: #64748b;
            background-color: #f8fafc;
            user-select: none;
            width: 50px;
        }

        td.action-col {
            text-align: center;
            width: 40px;
        }

        .btn-del-row {
            background: transparent;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            padding: 4px;
            font-size: 14px;
        }
        .btn-del-row:hover {
            color: var(--accent-red);
        }

        .instructions {
            margin-top: 20px;
            background-color: #ffffff;
            padding: 16px 24px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            font-size: 13px;
            color: #475569;
            line-height: 1.6;
        }

        .instructions ol {
            padding-left: 20px;
            margin-top: 6px;
        }
    </style>
</head>
<body>

    <div class="header-container">
        <h1 class="header-title">Государственный реестр АТД Республики Светлославия</h1>
        <p class="header-subtitle">Бланк учета административно-территориальных единиц и суверенных территорий</p>
    </div>

    <div class="toolbar">
        <button class="btn btn-primary" onclick="addRow()">
            <i class="fa-solid fa-plus"></i> Добавить строку
        </button>
        <button class="btn btn-success" onclick="copyForGoogleSheets()">
            <i class="fa-solid fa-copy"></i> Скопировать для Google Таблиц
        </button>
        <button class="btn btn-secondary" onclick="exportToCSV()">
            <i class="fa-solid fa-file-csv"></i> Скачать CSV
        </button>
        <button class="btn btn-danger" onclick="clearTable()">
            <i class="fa-solid fa-trash-can"></i> Очистить всё
        </button>
        <span id="statusMsg" class="status-msg"><i class="fa-solid fa-check"></i> Данные скопированы в буфер обмена!</span>
    </div>

    <div class="table-wrapper">
        <table id="registryTable">
            <thead>
                <!-- Строка 1: Номера показателей -->
                <tr class="header-row-numbers">
                    <th style="width: 40px;"></th>
                    <th style="width: 50px;">№</th>
                    <th>Наименование показателя</th>
                    <th>1</th>
                    <th>2</th>
                    <th>3</th>
                    <th>4</th>
                    <th>5</th>
                    <th>6</th>
                    <th>7</th>
                    <th>8</th>
                    <th>9</th>
                </tr>
                <!-- Строка 2: Названия столбцов -->
                <tr class="header-row-titles">
                    <th></th>
                    <th>№ п/п</th>
                    <th style="min-width: 180px;">Реестровый идентификатор</th>
                    <th style="min-width: 200px;">Наименование</th>
                    <th style="min-width: 160px;">Категория и уровень</th>
                    <th style="min-width: 160px;">Административный центр</th>
                    <th style="min-width: 200px;">Историко-географическая привязка</th>
                    <th style="min-width: 220px;">Пространственное описание</th>
                    <th style="min-width: 180px;">Правовые основания</th>
                    <th style="min-width: 220px;">Статус территории</th>
                    <th style="min-width: 180px;">Внутренняя структура</th>
                    <th style="min-width: 180px;">Примечания / Особые отметки</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <!-- Начальные 5 пустых строк для удобного заполнения -->
            </tbody>
        </table>
    </div>

    <div class="instructions">
        <strong>Инструкция по работе с реестром:</strong>
        <ol>
            <li>Вы можете сразу кликать на любую ячейку в таблице и вводить ваши данные.</li>
            <li>Кнопка <strong>«Скопировать для Google Таблиц»</strong> копирует готовую структуру вместе с номерами показателей. Нажмите её, затем перейдите в пустую Google Таблицу и нажмите <code>Ctrl + V</code> (или <code>Cmd + V</code>).</li>
            <li>Кнопка <strong>«Добавить строку»</strong> добавляет новое поле вниз таблицы.</li>
        </ol>
    </div>

    <script>
        const tableBody = document.getElementById('tableBody');

        // Инициализация стартовых строк
        function initTable(rowCount = 5) {
            tableBody.innerHTML = '';
            for (let i = 1; i <= rowCount; i++) {
                createRow(i);
            }
        }

        function createRow(index) {
            const tr = document.createElement('tr');
            
            // Кнопка удаления
            const tdAction = document.createElement('td');
            tdAction.className = 'action-col';
            tdAction.innerHTML = `<button class="btn-del-row" onclick="deleteRow(this)" title="Удалить строку"><i class="fa-solid fa-xmark"></i></button>`;
            tr.appendChild(tdAction);

            // № п/п
            const tdNum = document.createElement('td');
            tdNum.className = 'col-num';
            tdNum.innerText = index;
            tr.appendChild(tdNum);

            // 10 редактируемых полей (Реестровый идентификатор + 9 показателей)
            for (let i = 0; i < 10; i++) {
                const td = document.createElement('td');
                td.contentEditable = "true";
                tr.appendChild(td);
            }

            tableBody.appendChild(tr);
        }

        function addRow() {
            const currentCount = tableBody.rows.length;
            createRow(currentCount + 1);
        }

        function deleteRow(btn) {
            const row = btn.closest('tr');
            row.remove();
            reindexRows();
        }

        function reindexRows() {
            Array.from(tableBody.rows).forEach((row, index) => {
                row.cells[1].innerText = index + 1;
            });
        }

        function clearTable() {
            if (confirm('Вы уверены, что хотите полностью очистить таблицу?')) {
                initTable(3);
            }
        }

        // Копирование в формате TSV (для моментальной вставки в Google Sheets)
        function copyForGoogleSheets() {
            const rows = [];
            
            // Строка 1: Номера показателей
            rows.push(["№", "Наименование показателя", "1", "2", "3", "4", "5", "6", "7", "8", "9"].join("\t"));

            // Строка 2: Названия столбцов
            rows.push([
                "№ п/п",
                "Реестровый идентификатор",
                "Наименование",
                "Категория и уровень",
                "Административный центр",
                "Историко-географическая привязка",
                "Пространственное описание",
                "Правовые основания",
                "Статус территории",
                "Внутренняя структура",
                "Примечания / Особые отметки"
            ].join("\t"));

            // Данные пользователей
            Array.from(tableBody.rows).forEach(row => {
                const rowData = [];
                // Начинаем с 1 ячейки (пропускаем кнопку удаления)
                for (let i = 1; i < row.cells.length; i++) {
                    let text = row.cells[i].innerText.replace(/\n/g, ' ').trim();
                    rowData.push(text);
                }
                rows.push(rowData.join("\t"));
            });

            const tsvContent = rows.join("\n");
            
            navigator.clipboard.writeText(tsvContent).then(() => {
                showStatus();
            }).catch(err => {
                alert('Не удалось скопировать данные: ' + err);
            });
        }

        function exportToCSV() {
            const rows = [];
            rows.push(["№", "Наименование показателя", "1", "2", "3", "4", "5", "6", "7", "8", "9"]);
            rows.push([
                "№ п/п",
                "Реестровый идентификатор",
                "Наименование",
                "Категория и уровень",
                "Административный центр",
                "Историко-географическая привязка",
                "Пространственное описание",
                "Правовые основания",
                "Статус территории",
                "Внутренняя структура",
                "Примечания / Особые отметки"
            ]);

            Array.from(tableBody.rows).forEach(row => {
                const rowData = [];
                for (let i = 1; i < row.cells.length; i++) {
                    let text = row.cells[i].innerText.replace(/"/g, '""').trim();
                    rowData.push(`"${text}"`);
                }
                rows.push(rowData.join(","));
            });

            const csvString = "\uFEFF" + rows.map(e => e.join(",")).join("\n");
            const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            const url = URL.createURL(blob);
            link.setAttribute("href", url);
            link.setAttribute("download", "Реестр_АТД_Светлославия.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function showStatus() {
            const msg = document.getElementById('statusMsg');
            msg.classList.add('visible');
            setTimeout(() => {
                msg.classList.remove('visible');
            }, 3000);
        }

        // Запуск при загрузке
        initTable(5);
    </script>
</body>
</html>
